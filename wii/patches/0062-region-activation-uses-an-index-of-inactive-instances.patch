+// Whether an inactive instance lies outside the region, the way the region walk has always tested it.
+static bool activationRegionOutside(Runner* runner, DataWin* dataWin, Instance* inst, GMLReal left, GMLReal top, GMLReal right, GMLReal bottom) {
+    Sprite* spr = Collision_getSprite(dataWin, inst);
+    if (spr != nullptr) {
+        InstanceBBox bbox;
+        if (!Collision_memoBBox(runner, inst, spr, &bbox)) bbox = Collision_computeBBox(runner, inst);
+        return bbox.right < left || bbox.left > right || bbox.bottom < top || bbox.top > bottom;
+    }
+    return inst->x > right || left > inst->x || inst->y > bottom || top > inst->y;
+}
+
+// The inactive instances in room order, bucketed by box over the collision grid's cells. Rebuilt when the runner's
+// activation version or the grid's inactive edits moved since: anything that changes who sits out, the instance
+// list, or the box of an instance that sits out moves one of them. Activations made here are skipped by their flag.
+typedef struct {
+    bool built;
+    uint32_t version, gridEdits;
+    SpatialGrid* grid;
+    Instance** entries;
+    int32_t** cells;
+    int32_t cellCount;
+    int32_t* unbucketed;
+    int32_t* picked;
+    uint32_t* seen;
+    uint32_t stamp;
+} ActivationIndex;
+static ActivationIndex activationIndex;
+
+static bool activationCoordsUsable(GMLReal left, GMLReal top, GMLReal right, GMLReal bottom) {
+    GMLReal limit = 1000000.0;
+    return limit > GMLReal_fabs(left) && limit > GMLReal_fabs(top) && limit > GMLReal_fabs(right) &&
+           limit > GMLReal_fabs(bottom) && right >= left && bottom >= top;
+}
+
+static void activationIndexRebuild(Runner* runner, DataWin* dataWin) {
+    ActivationIndex* ix = &activationIndex;
+    SpatialGrid* grid = runner->spatialGrid;
+    int32_t cellCount = (int32_t) grid->gridWidth * grid->gridHeight;
+    if (cellCount > ix->cellCount) {
+        ix->cells = (int32_t**) realloc(ix->cells, (size_t) cellCount * sizeof(int32_t*));
+        for (int32_t c = ix->cellCount; cellCount > c; c++) ix->cells[c] = nullptr;
+        ix->cellCount = cellCount;
+    }
+    repeat(cellCount, c) arrsetlen(ix->cells[c], 0);
+    arrsetlen(ix->entries, 0);
+    arrsetlen(ix->unbucketed, 0);
+    int32_t count = (int32_t) arrlen(runner->instances);
+    repeat(count, i) {
+        Instance* inst = runner->instances[i];
+        if (inst->active || inst->destroyed) continue;
+        int32_t entry = (int32_t) arrlen(ix->entries);
+        arrput(ix->entries, inst);
+        GMLReal box[4];
+        Sprite* spr = Collision_getSprite(dataWin, inst);
+        if (spr != nullptr) {
+            InstanceBBox bbox;
+            if (!Collision_memoBBox(runner, inst, spr, &bbox)) bbox = Collision_computeBBox(runner, inst);
+            box[0] = bbox.left; box[1] = bbox.top; box[2] = bbox.right; box[3] = bbox.bottom;
+        } else {
+            box[0] = box[2] = inst->x;
+            box[1] = box[3] = inst->y;
+        }
+        if (!activationCoordsUsable(box[0], box[1], box[2], box[3])) {
+            arrput(ix->unbucketed, entry);
+            continue;
+        }
+        SpatialGridRange range = SpatialGrid_computeCellRange(grid, box[0], box[1], box[2], box[3]);
+        for (int32_t gx = range.minGridX; range.maxGridX >= gx; gx++)
+            for (int32_t gy = range.minGridY; range.maxGridY >= gy; gy++)
+                arrput(ix->cells[SpatialGrid_cellIndex(grid, gx, gy)], entry);
+    }
+    arrsetlen(ix->seen, arrlen(ix->entries));
+    repeat(arrlen(ix->seen), i) ix->seen[i] = 0;
+    ix->stamp = 0;
+    ix->grid = grid;
+    ix->version = runner->activationVersion;
+    ix->gridEdits = grid->inactiveEdits;
+    ix->built = true;
+}
+
+static int compareInt32Ascending(const void* a, const void* b) {
+    int32_t x = *(const int32_t*) a, y = *(const int32_t*) b;
+    return (x > y) - (x < y);
+}
+
+// Activates the inactive instances inside the region through the index, in room order. False: walk the room instead.
+static bool activationRegionIndexed(Runner* runner, DataWin* dataWin, GMLReal left, GMLReal top, GMLReal right, GMLReal bottom) {
+    ActivationIndex* ix = &activationIndex;
+    SpatialGrid* grid = runner->spatialGrid;
+    if (grid == nullptr || !activationCoordsUsable(left, top, right, bottom)) return false;
+    if (!ix->built || ix->grid != grid || ix->version != runner->activationVersion || ix->gridEdits != grid->inactiveEdits)
+        activationIndexRebuild(runner, dataWin);
+
+    if (++ix->stamp == 0) {
+        repeat(arrlen(ix->seen), i) ix->seen[i] = 0;
+        ix->stamp = 1;
+    }
+    arrsetlen(ix->picked, 0);
+    SpatialGridRange range = SpatialGrid_computeCellRange(grid, left, top, right, bottom);
+    for (int32_t gx = range.minGridX; range.maxGridX >= gx; gx++) {
+        for (int32_t gy = range.minGridY; range.maxGridY >= gy; gy++) {
+            int32_t* cell = ix->cells[SpatialGrid_cellIndex(grid, gx, gy)];
+            repeat(arrlen(cell), ci) {
+                int32_t entry = cell[ci];
+                if (ix->seen[entry] == ix->stamp) continue;
+                ix->seen[entry] = ix->stamp;
+                arrput(ix->picked, entry);
+            }
+        }
+    }
+    repeat(arrlen(ix->unbucketed), u) {
+        int32_t entry = ix->unbucketed[u];
+        if (ix->seen[entry] == ix->stamp) continue;
+        ix->seen[entry] = ix->stamp;
+        arrput(ix->picked, entry);
+    }
+    int32_t pickedCount = (int32_t) arrlen(ix->picked);
+    if (pickedCount > 1) qsort(ix->picked, (size_t) pickedCount, sizeof(int32_t), compareInt32Ascending);
+
+    repeat(pickedCount, p) {
+        Instance* inst = ix->entries[ix->picked[p]];
+        if (inst->active || inst->destroyed) continue;
+        if (!activationRegionOutside(runner, dataWin, inst, left, top, right, bottom)) Runner_setActiveState(runner, inst, true);
+    }
+    // Only this call's own activations moved the version since the check above; they are skipped by their flag.
+    ix->version = runner->activationVersion;
+    return true;
+}
