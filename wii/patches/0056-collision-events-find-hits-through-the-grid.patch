+// The sorted walk's tests for one pair: none of them change anything, so hits can be looked for in any order.
+static bool collisionPairHits(Runner* runner, Instance* self, Instance* other, int32_t targetObjIndex, InstanceBBox* bboxSelf, Sprite** sprSelf, bool* selfDirty) {
+    if (!other->active || other == self) return false;
+    if (mostSpecificCollisionTarget(runner, self, other) != targetObjIndex) return false;
+    if (*selfDirty) {
+        *bboxSelf = Collision_computeBBox(runner, self);
+        *sprSelf = Collision_getSprite(runner->dataWin, self);
+        *selfDirty = false;
+    }
+    InstanceBBox bboxOther = Collision_computeBBox(runner, other);
+    if (!bboxSelf->valid || !bboxOther.valid) return false;
+    if (bboxSelf->left >= bboxOther.right || bboxOther.left >= bboxSelf->right || bboxSelf->top >= bboxOther.bottom || bboxOther.top >= bboxSelf->bottom) return false;
+    Sprite* sprOther = Collision_getSprite(runner->dataWin, other);
+    bool needsPrecise = (*sprSelf != nullptr && (*sprSelf)->sepMasks == 1) || (sprOther != nullptr && sprOther->sepMasks == 1) || Collision_obbNeedsSAT(*sprSelf, self) || Collision_obbNeedsSAT(sprOther, other);
+    return !needsPrecise || Collision_instancesOverlapPrecise(runner, self, other, *bboxSelf, bboxOther);
+}
+
+// The first instance in the sorted walk's order that self hits, when the grid cells under self hold fewer instances
+// than the target's bucket; otherwise *walkAll. The grid is not synced (that would reorder cells for later queries), so
+// dirty bucket members are tested directly.
+static Instance* firstCollisionHit(Runner* runner, Instance* self, int32_t targetObjIndex, InstanceBBox* bboxSelf, Sprite** sprSelf, bool* selfDirty, bool* walkAll) {
+    Instance** bucket = runner->instancesByObject[targetObjIndex];
+    int32_t bucketCount = (int32_t) arrlen(bucket);
+    if (bucketCount == 0) return nullptr;
+    InstanceBBox box = Collision_computeBBox(runner, self);
+    if (!box.valid) return nullptr;
+    GMLReal limit = 1000000.0;
+    if (!(GMLReal_fabs(box.left) < limit && GMLReal_fabs(box.right) < limit && GMLReal_fabs(box.top) < limit && GMLReal_fabs(box.bottom) < limit)) {
+        *walkAll = true;
+        return nullptr;
+    }
+    SpatialGrid* grid = runner->spatialGrid;
+    SpatialGridRange range = SpatialGrid_computeCellRange(grid, box.left, box.top, box.right, box.bottom);
+    int32_t cellTotal = 0;
+    for (int32_t gx = range.minGridX; range.maxGridX >= gx; gx++)
+        for (int32_t gy = range.minGridY; range.maxGridY >= gy; gy++)
+            cellTotal += (int32_t) arrlen(grid->grid[SpatialGrid_cellIndex(grid, gx, gy)]);
+    if (cellTotal >= bucketCount) {
+        *walkAll = true;
+        return nullptr;
+    }
+
+    SpatialGridQuery query = SpatialGrid_prepareQuery(runner, box.left, box.top, box.right, box.bottom, targetObjIndex);
+    Instance* best = nullptr;
+    for (int32_t gx = query.range.minGridX; query.range.maxGridX >= gx; gx++) {
+        for (int32_t gy = query.range.minGridY; query.range.maxGridY >= gy; gy++) {
+            Instance** cell = grid->grid[SpatialGrid_cellIndex(grid, gx, gy)];
+            int32_t cellLen = (int32_t) arrlen(cell);
+            repeat(cellLen, ci) {
+                Instance* other = cell[ci];
+                if (other->spatialGridDirty || other->lastCollisionQueryId == query.queryId) continue;
+                other->lastCollisionQueryId = query.queryId;
+                if ((best == nullptr || 0 > sortInstancesByObjectIndexThenInstanceIdAscending(&other, &best)) && collisionPairHits(runner, self, other, targetObjIndex, bboxSelf, sprSelf, selfDirty))
+                    best = other;
+            }
+        }
+    }
+    repeat(bucketCount, bi) {
+        Instance* other = bucket[bi];
+        if (!other->spatialGridDirty) continue;
+        if ((best == nullptr || 0 > sortInstancesByObjectIndexThenInstanceIdAscending(&other, &best)) && collisionPairHits(runner, self, other, targetObjIndex, bboxSelf, sprSelf, selfDirty))
+            best = other;
+    }
+    return best;
+}
