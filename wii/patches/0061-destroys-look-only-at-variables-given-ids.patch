     IntRValueHashMap_freeAllValues(&instance->selfVars);
     arrfree(instance->collisionCells);
     instance->collisionCells = nullptr;
+    arrfree(instance->idVarKeys);
+    instance->idVarKeys = nullptr;
 }
 
