+// Whether a pixel scan over these samples can land on a set pixel of the instance's mask at all: rotation keeps a
+// sample's distance from the instance, and scale stretches it at most by its larger factor. A power bomb's round
+// blast leaves the solids in its box's corners with no reachable sample; they skip the scan.
+static inline bool Collision_scanCanReach(Sprite* spr, Instance* inst, int32_t startX, int32_t endX, int32_t startY, int32_t endY, GMLReal sampleOffset, bool compatMode) {
+    if (!Collision_hasFrameMasks(spr)) return true;
+    float reach = DataWin_spriteMaskReach(spr, ((uint32_t) inst->imageIndex) % spr->maskCount);
+    if (0.0f > reach) return false;
+    double scale = fmax(fabs((double) inst->imageXscale), fabs((double) inst->imageYscale));
+    double limit = (double) reach * scale + 2.0;
+    double lastX = (double) (compatMode ? endX : endX - 1) + (double) sampleOffset;
+    double lastY = (double) (compatMode ? endY : endY - 1) + (double) sampleOffset;
+    double nearX = fmax((double) startX + (double) sampleOffset, fmin((double) inst->x, lastX));
+    double nearY = fmax((double) startY + (double) sampleOffset, fmin((double) inst->y, lastY));
+    double dx = nearX - (double) inst->x, dy = nearY - (double) inst->y;
+    return limit * limit >= dx * dx + dy * dy;
+}
