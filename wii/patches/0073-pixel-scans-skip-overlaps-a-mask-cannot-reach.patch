 // ===[ FREE ]===
 
+static double reachAlong(int32_t pixel, int32_t origin) {
+    double low = (double) (pixel == 0 ? -1 : pixel) - (double) origin, high = (double) (pixel + 1) - (double) origin;
+    return fmax(fabs(low), fabs(high));
+}
+
+float DataWin_spriteMaskReach(Sprite* spr, uint32_t frameIdx) {
+    if (spr->maskReach == nullptr) {
+        spr->maskReach = (float*) safeMalloc(spr->maskCount * sizeof(float));
+        repeat(spr->maskCount, i) spr->maskReach[i] = -2.0f;
+    }
+    if (spr->maskReach[frameIdx] > -1.5f) return spr->maskReach[frameIdx];
+    uint8_t* mask = spr->masks[frameIdx];
+    uint32_t bytesPerRow = (spr->maskWidth + 7) / 8;
+    double far = -1.0;
+    repeat(spr->maskHeight, my) {
+        uint8_t* row = mask + my * bytesPerRow;
+        int32_t first = -1, last = -1;
+        repeat(spr->maskWidth, mx) {
+            if (row[mx >> 3] & (1 << (7 - (mx & 7)))) {
+                if (0 > first) first = (int32_t) mx;
+                last = (int32_t) mx;
+            }
+        }
+        if (0 > first) continue;
+        // Across a row the distance is largest at one of its two ends.
+        double dy = reachAlong((int32_t) my + spr->maskOffsetY, spr->originY);
+        double dx = fmax(reachAlong(first + spr->maskOffsetX, spr->originX), reachAlong(last + spr->maskOffsetX, spr->originX));
+        double d = sqrt(dx * dx + dy * dy);
+        if (d > far) far = d;
+    }
+    spr->maskReach[frameIdx] = (float) (far >= 0.0 ? far + 0.01 : -1.0);
+    return spr->maskReach[frameIdx];
+}
