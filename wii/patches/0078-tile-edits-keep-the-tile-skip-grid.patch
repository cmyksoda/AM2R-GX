+// Puts a tile into the cells its box covers, or among the always visited when it has no finite box or its cells leave
+// the grid: a query clamped to the grid's edge would miss it there.
+static void tileSkipPlace(TileSkipRun* run, const RoomTile* tile, int32_t rel) {
+    double box[4];
+    int32_t span[4];
+    if (run->cells != nullptr && tileSkipBox(tile, box)) {
+        tileSkipSpan(run, box, span);
+        if (span[0] >= 0 && span[2] >= 0 && run->cellsX > span[1] && run->cellsY > span[3]) {
+            for (int32_t cy = span[2]; span[3] >= cy; cy++)
+                for (int32_t cx = span[0]; span[1] >= cx; cx++)
+                    arrput(run->cells[cy * run->cellsX + cx], rel);
+            return;
+        }
+    }
+    arrput(run->always, rel);
+    if (arrlen(run->always) > TILE_SKIP_MAX_ALWAYS) tileSkip.gridBuilt = false;
+}
+
+// Takes a rank out of one cell (or the always list); with shift, the ranks after it move down one.
+static void tileSkipDropFrom(int32_t* list, int32_t rel, bool shift) {
+    int32_t n = (int32_t) arrlen(list), kept = 0;
+    repeat(n, k) {
+        if (list[k] != rel) list[kept++] = shift && list[k] > rel ? list[k] - 1 : list[k];
+    }
+    if (n > kept) arrsetlen(list, kept);
+}
+
+static void tileSkipDrop(TileSkipRun* run, int32_t rel, bool shift) {
+    tileSkipDropFrom(run->always, rel, shift);
+    if (run->cells != nullptr) repeat(run->cellsX * run->cellsY, c) tileSkipDropFrom(run->cells[c], rel, shift);
+}
+
+// The run holding that rank, when it is the run of that depth; else the grid is built again at its next query.
+static TileSkipRun* tileSkipRunAt(int32_t rank, int32_t depth) {
+    repeat(arrlen(tileSkip.runs), r) {
+        TileSkipRun* run = &tileSkip.runs[r];
+        if (rank >= run->rankStart && run->rankEnd > rank) {
+            if (run->depth == depth) return run;
+            break;
+        }
+    }
+    tileSkip.gridBuilt = false;
+    return nullptr;
+}
+
+static void tileSkipShiftAfter(TileSkipRun* run, int32_t by) {
+    for (TileSkipRun* later = run + 1; &tileSkip.runs[arrlen(tileSkip.runs)] > later; later++) {
+        later->rankStart += by;
+        later->rankEnd += by;
+    }
+}
+
+// A new tile takes the rank after every tile of its depth (it is last in the array): the end of its depth's run, or a
+// new run without cells when the depth had no tiles.
+static void tileSkipAdded(Runner* runner, Room* room, int32_t rank, int32_t index) {
+    int32_t depth = room->tiles[index].tileDepth, count = (int32_t) arrlen(tileSkip.runs), at = 0;
+    while (count > at && tileSkip.runs[at].depth > depth) at++;
+    if (count > at && tileSkip.runs[at].depth == depth) {
+        if (tileSkip.runs[at].rankEnd != rank) {
+            tileSkip.gridBuilt = false;
+            return;
+        }
+    } else {
+        if ((count > at ? tileSkip.runs[at].rankStart : (int32_t) arrlen(tileSkip.seen)) != rank) {
+            tileSkip.gridBuilt = false;
+            return;
+        }
+        TileSkipRun run;
+        memset(&run, 0, sizeof run);
+        run.depth = depth;
+        run.rankStart = rank;
+        run.rankEnd = rank;
+        run.cellSize = TILE_SKIP_CELL;
+        arrins(tileSkip.runs, at, run);
+    }
+    TileSkipRun* run = &tileSkip.runs[at];
+    tileSkipPlace(run, &room->tiles[index], run->rankEnd - run->rankStart);
+    run->rankEnd++;
+    tileSkipShiftAfter(run, 1);
+    arrput(tileSkip.seen, 0);
+    tileSkipRecord(runner, room);
+}
+
+static void tileSkipDeleted(Runner* runner, Room* room, int32_t rank, int32_t depth) {
+    TileSkipRun* run = tileSkipRunAt(rank, depth);
+    if (run == nullptr) return;
+    tileSkipDrop(run, rank - run->rankStart, true);
+    run->rankEnd--;
+    tileSkipShiftAfter(run, -1);
+    arrsetlen(tileSkip.seen, arrlen(tileSkip.seen) - 1);
+    tileSkipRecord(runner, room);
+}
+
+static void tileSkipRescaled(Runner* runner, Room* room, int32_t rank, int32_t index) {
+    TileSkipRun* run = tileSkipRunAt(rank, room->tiles[index].tileDepth);
+    if (run == nullptr) return;
+    tileSkipDrop(run, rank - run->rankStart, false);
+    tileSkipPlace(run, &room->tiles[index], rank - run->rankStart);
+    tileSkipRecord(runner, room);
+}
