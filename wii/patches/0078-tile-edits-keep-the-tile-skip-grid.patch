+// A tile's box as left, right, top, bottom; false when it isn't finite.
+static bool tileSkipBox(const RoomTile* t, double box[4]) {
+    double x0 = t->x, x1 = x0 + (double) t->width * (double) t->scaleX;
+    double y0 = t->y, y1 = y0 + (double) t->height * (double) t->scaleY;
+    if (!(isfinite(x1) && isfinite(y1) && 1e7 > fabs(x0) && 1e7 > fabs(x1) && 1e7 > fabs(y0) && 1e7 > fabs(y1))) return false;
+    box[0] = fmin(x0, x1);
+    box[1] = fmax(x0, x1);
+    box[2] = fmin(y0, y1);
+    box[3] = fmax(y0, y1);
+    return true;
+}
+
+// The cells (first and last column, first and last row) a box covers with its margin, not yet clamped to the grid.
+static void tileSkipSpan(const TileSkipRun* run, const double box[4], int32_t span[4]) {
+    span[0] = (int32_t) floor((box[0] - tileSkipMargin(box[0]) - run->originX) / run->cellSize);
+    span[1] = (int32_t) floor((box[1] + tileSkipMargin(box[1]) - run->originX) / run->cellSize);
+    span[2] = (int32_t) floor((box[2] - tileSkipMargin(box[2]) - run->originY) / run->cellSize);
+    span[3] = (int32_t) floor((box[3] + tileSkipMargin(box[3]) - run->originY) / run->cellSize);
+}
+
+static void tileSkipClamp(const TileSkipRun* run, int32_t span[4]) {
+    if (0 > span[0]) span[0] = 0;
+    if (0 > span[2]) span[2] = 0;
+    if (span[1] >= run->cellsX) span[1] = run->cellsX - 1;
+    if (span[3] >= run->cellsY) span[3] = run->cellsY - 1;
+}
