+// Clamp the ordered line endpoints to the grid without calling fmin/fmax repeatedly.
+// Keep the library behavior for exceptional endpoints, including signaling NaNs.
+static inline void collisionLineGridBounds(GMLReal a, GMLReal b, GMLReal limit, GMLReal* low, GMLReal* high) {
+    if (isnan(a) || isnan(b)) {
+        *low = GMLReal_fmin(GMLReal_fmax(GMLReal_fmin(a, b), 0), limit);
+        *high = GMLReal_fmin(GMLReal_fmax(GMLReal_fmax(a, b), 0), limit);
+        return;
+    }
+    if (a > b) { GMLReal tmp = a; a = b; b = tmp; }
+    if (!(a >= 0)) a = 0;
+    if (!(b >= 0)) b = 0;
+    if (a > limit) a = limit;
+    if (b > limit) b = limit;
+    *low = a;
+    *high = b;
+}
