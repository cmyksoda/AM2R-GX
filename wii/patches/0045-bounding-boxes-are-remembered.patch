+// Instances that have not moved are asked for their box over and over (every enemy's activate_region each step), so
+// the last box is reused while every input is bit for bit the same: the instance's, its sprite's geometry and the mode.
+static inline InstanceBBox Collision_computeBBox(Runner* runner, Instance* inst) {
+    Sprite* spr = Collision_getSprite(runner->dataWin, inst);
+    if (spr == nullptr) return Collision_computeBBoxUncached(runner, inst);
+
+    union { float f; uint32_t u; } in[5] = {
+        { inst->x }, { inst->y }, { inst->imageXscale }, { inst->imageYscale }, { inst->imageAngle }
+    };
+    int32_t geometry[9] = {
+        (int32_t) spr->bboxMode, spr->marginLeft, spr->marginRight, spr->marginTop, spr->marginBottom,
+        (int32_t) spr->width, (int32_t) spr->height, spr->originX, spr->originY
+    };
+    int32_t sprIdx = (inst->maskIndex >= 0) ? inst->maskIndex : inst->spriteIndex;
+    bool same = inst->bboxMemoValid && inst->bboxMemoSprite == sprIdx && inst->bboxMemoCompat == runner->collisionCompatibilityMode;
+    for (int32_t i = 0; same && 5 > i; i++) same = inst->bboxMemoInputs[i] == in[i].u;
+    for (int32_t i = 0; same && 9 > i; i++) same = inst->bboxMemoGeometry[i] == geometry[i];
+    if (same) {
+        InstanceBBox ret;
+        ret.left = inst->bboxMemoEdges[0];
+        ret.right = inst->bboxMemoEdges[1];
+        ret.top = inst->bboxMemoEdges[2];
+        ret.bottom = inst->bboxMemoEdges[3];
+        ret.valid = true;
+        return ret;
+    }
+
+    InstanceBBox ret = Collision_computeBBoxUncached(runner, inst);
+    inst->bboxMemoValid = ret.valid;
+    if (ret.valid) {
+        inst->bboxMemoCompat = runner->collisionCompatibilityMode;
+        inst->bboxMemoSprite = sprIdx;
+        repeat(5, i) inst->bboxMemoInputs[i] = in[i].u;
+        repeat(9, i) inst->bboxMemoGeometry[i] = geometry[i];
+        inst->bboxMemoEdges[0] = ret.left;
+        inst->bboxMemoEdges[1] = ret.right;
+        inst->bboxMemoEdges[2] = ret.top;
+        inst->bboxMemoEdges[3] = ret.bottom;
+    }
+    return ret;
+}
+
 static inline bool Collision_hasFrameMasks(Sprite* sprite) {
     return sprite != nullptr && sprite->sepMasks == 1 && sprite->masks != nullptr && sprite->maskCount > 0;
 }
