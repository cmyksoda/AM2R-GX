Reason: ds_list_set reads three arguments but rejected three and accepted missing values.
Validate the complete call and release the previous list value when replacing it.
Upstream: correctness fix, every platform. Retire this patch when merged.

--- a/src/vm_builtins.c
+++ b/src/vm_builtins.c
@@ -4897,15 +4897,14 @@
 }
 
 static RValue builtin_ds_list_set(VMContext* ctx, RValue* args, int32_t argCount) {
-    REQUIRE_ARGC_AT_LEAST("ds_list_set", 1, RValue_makeUndefined());
-    REQUIRE_ARGC_AT_MOST("ds_list_set", 2, RValue_makeUndefined());
+    REQUIRE_ARGC("ds_list_set", 3, RValue_makeUndefined());
     Runner* runner = ctx->runner;
     int32_t id = RValue_toInt32(args[0]);
     int32_t pos = RValue_toInt32(args[1]);
     DsList* list = dsListGet(runner, id);
     if (list == nullptr) return RValue_makeUndefined();
     if (pos >= 0 && pos < arrlen(list->items)) {
-        list->items[pos] = RValue_makeIndependent(args[2]);
+        RValue_copyIntoSlot(&list->items[pos], args[2]);
     }
     return RValue_makeUndefined();
 }
