+        (int32_t) spr->bboxMode, spr->marginLeft, spr->marginRight, spr->marginTop, spr->marginBottom,
+        (int32_t) spr->width, (int32_t) spr->height, spr->originX, spr->originY
+    };
+    int32_t sprIdx = (inst->maskIndex >= 0) ? inst->maskIndex : inst->spriteIndex;
+    if (!inst->bboxMemoValid || inst->bboxMemoSprite != sprIdx || inst->bboxMemoCompat != runner->collisionCompatibilityMode) return false;
+    repeat(5, i) if (inst->bboxMemoInputs[i] != in[i].u) return false;
+    repeat(9, i) if (inst->bboxMemoGeometry[i] != geometry[i]) return false;
