+// A tile's array index from its pseudo index, or -1 when it was deleted: the deleted pseudo indices are kept in order.
+static int32_t tileRunIndexOfPseudo(int32_t pseudo) {
+    int32_t lo = 0, hi = (int32_t) arrlen(tileRunGone);
+    while (hi > lo) {
+        int32_t mid = lo + (hi - lo) / 2;
+        if (pseudo > tileRunGone[mid]) lo = mid + 1;
+        else hi = mid;
+    }
+    if ((int32_t) arrlen(tileRunGone) > lo && tileRunGone[lo] == pseudo) return -1;
+    return pseudo - lo;
+}
+
+// Speed blocks look up their tile with tile_layer_find, which walked every tile of the room: 126 calls in one frame
+// took ~1.9 ms on the vWii in rm_a6b02. The grid holds every live tile of a depth in the cells its box covers.
+bool Runner_tileLayerFind(Runner* runner, Room* room, int32_t depth, GMLReal qx, GMLReal qy, int32_t* index) {
+    if (!tileSkipCurrent(runner, room) || !tileRunCurrent(runner, room) || !(isfinite(qx) && isfinite(qy))) return false;
+    *index = -1;
+    TileSkipRun* run = nullptr;
+    repeat(arrlen(tileSkip.runs), r) {
+        if (tileSkip.runs[r].depth == depth) run = &tileSkip.runs[r];
+    }
+    if (run == nullptr) return true;
+    int32_t* cell = nullptr;
+    if (run->cells != nullptr) {
+        double cx = floor((qx - run->originX) / run->cellSize), cy = floor((qy - run->originY) / run->cellSize);
+        if (cx >= 0 && cy >= 0 && run->cellsX > cx && run->cellsY > cy) cell = run->cells[(int32_t) cy * run->cellsX + (int32_t) cx];
+    }
+    for (int32_t pass = 0; 2 > pass; pass++) {
+        int32_t* list = pass == 0 ? run->always : cell;
+        repeat(arrlen(list), k) {
+            int32_t at = tileRunIndexOfPseudo(list[k]);
+            if (*index >= at || at >= (int32_t) room->tileCount) continue;
+            RoomTile* tile = &room->tiles[at];
+            if (tile->tileDepth != depth) continue;
+            GMLReal w = (GMLReal) tile->width * (GMLReal) tile->scaleX;
+            GMLReal h = (GMLReal) tile->height * (GMLReal) tile->scaleY;
+            if (qx >= (GMLReal) tile->x && qx < (GMLReal) tile->x + w && qy >= (GMLReal) tile->y && qy < (GMLReal) tile->y + h)
+                *index = at;
+        }
+    }
+    return true;
+}
