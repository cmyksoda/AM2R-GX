+// The instances in runner->instances that were given an id-like number while there, in no order: a destroy's id rewrite
+// looks only at these instead of at every instance in the room.
+extern Instance** Instance_idHolders;
+void Instance_listIdHolder(Instance* inst);
+void Instance_unlistIdHolder(Instance* inst);
+
 // Set a self variable by varID. Frees the old value if present (decRefs owned arrays).
 // Always takes an independent reference with RValue_makeIndependent.
 // The caller retains ownership of their original `val` and remains responsible for freeing it (via RValue_free) when done.
@@ -144,6 +154,7 @@
