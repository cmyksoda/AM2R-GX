+    // In runner->instances (set where an instance joins it, cleared where it leaves), and its place in Instance_idHolders
+    // (-1: not listed).
+    bool inRoomList;
+    int32_t idHolderSlot;
     // Increases along runner->instances (set as it joins the list), so an index can hand back room order.
     uint32_t listOrdinal;
     // instance_activate_region's index: the build that holds this instance (0: none) and its one live entry there.
@@ -132,6 +136,12 @@
