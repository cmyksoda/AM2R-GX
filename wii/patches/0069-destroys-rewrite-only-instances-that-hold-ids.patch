     if (RValue_isIdLike(independentVal)) {
         inst->mayHoldIds = true;
+        if (inst->idHolderSlot < 0 && inst->inRoomList) Instance_listIdHolder(inst);
         repeat(arrlen(inst->idVarKeys), i) if (inst->idVarKeys[i] == varID) return;
         arrput(inst->idVarKeys, varID);
     }
--- a/src/instance.c
+++ b/src/instance.c
@@ -9,8 +9,28 @@
 #include "utils.h"
 #include "int_rvalue_hashmap.h"
 
+Instance** Instance_idHolders = nullptr;
+
+void Instance_listIdHolder(Instance* inst) {
+    if (inst->idHolderSlot >= 0) return;
+    inst->idHolderSlot = (int32_t) arrlen(Instance_idHolders);
+    arrput(Instance_idHolders, inst);
+}
+
+void Instance_unlistIdHolder(Instance* inst) {
+    int32_t slot = inst->idHolderSlot;
+    if (0 > slot || slot >= (int32_t) arrlen(Instance_idHolders) || Instance_idHolders[slot] != inst) return;
+    Instance* last = arrpop(Instance_idHolders);
+    if (last != inst) {
+        Instance_idHolders[slot] = last;
+        last->idHolderSlot = slot;
+    }
+    inst->idHolderSlot = -1;
+}
+
 Instance* Instance_create(uint32_t instanceId, int32_t objectIndex, GMLReal x, GMLReal y) {
     Instance* inst = (Instance *)safeCalloc(1, sizeof(Instance));
+    inst->idHolderSlot = -1;
     inst->instanceId = instanceId;
     inst->objectIndex = objectIndex;
     inst->refCount = 0;
@@ -96,6 +116,7 @@
 
 void Instance_free(Instance* instance) {
     if (instance == nullptr) return;
+    Instance_unlistIdHolder(instance);
 
     Instance_freeContents(instance);
     free(instance);
