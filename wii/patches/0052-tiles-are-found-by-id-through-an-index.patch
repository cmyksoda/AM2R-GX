+// tile_set_alpha and its kin looked a tile up by walking the room's whole array; oTilesRandomAlpha sets every tile in
+// its list each step (~4.7 ms in rm_a5a08). Ids map to their first index, rebuilt when the room, its array or its
+// length changes or a tile builtin edits it; a hit is confirmed by its id, and a room with repeated ids keeps the walk.
+static struct { uint32_t key; int32_t value; }* tileIndexById = nullptr;
+static Room* tileIndexRoom;
+static RoomTile* tileIndexTiles;
+static uint32_t tileIndexCount;
+static bool tileIndexStale = true, tileIndexRepeats;
+
+static void buildTileIndex(Room* room) {
+    hmfree(tileIndexById);
+    tileIndexRepeats = false;
+    for (int32_t i = (int32_t) room->tileCount - 1; i >= 0; i--) {
+        if (hmgeti(tileIndexById, room->tiles[i].instanceID) >= 0) tileIndexRepeats = true;
+        hmput(tileIndexById, room->tiles[i].instanceID, i);
+    }
+    tileIndexRoom = room;
+    tileIndexTiles = room->tiles;
+    tileIndexCount = room->tileCount;
+    tileIndexStale = false;
+}
+
+static int32_t findTileIndex(Room* room, uint32_t id) {
+    if (tileIndexStale || tileIndexRoom != room || tileIndexTiles != room->tiles || tileIndexCount != room->tileCount)
+        buildTileIndex(room);
+    if (!tileIndexRepeats) {
+        ptrdiff_t k = hmgeti(tileIndexById, id);
+        if (k >= 0 && (uint32_t) tileIndexById[k].value < room->tileCount &&
+            room->tiles[tileIndexById[k].value].instanceID == id) return tileIndexById[k].value;
+    }
+    // A miss is settled by the walk the index replaced; a tile the index missed means it is out of date.
+    repeat(room->tileCount, i) {
+        if (room->tiles[i].instanceID != id) continue;
+        if (!tileIndexRepeats) tileIndexStale = true;
+        return (int32_t) i;
+    }
+    return -1;
+}
