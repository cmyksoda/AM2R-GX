+// GMS1 rooms hold many more tiles than instances. A tile run from the last rebuild that is still sorted at the room's
+// current depths, and has every tile once, is reused as is; only the rest is sorted, then the two runs are merged.
+static Drawable* drawableTileRun = nullptr;
+
+static void mergeTilesIntoDrawables(Runner* runner, Room* room) {
+    static Drawable* rest = nullptr;
+    Drawable* oldTiles;
+    int32_t tileCount = (int32_t) room->tileCount;
+    bool reuse = (int32_t) arrlen(drawableTileRun) == tileCount;
+
+    oldTiles = drawableTileRun;
+    for (int32_t i = 0; reuse && tileCount > i; i++) {
+        if (0 > oldTiles[i].tileIndex || oldTiles[i].tileIndex >= tileCount) reuse = false;
+        else oldTiles[i].depth = room->tiles[oldTiles[i].tileIndex].tileDepth;
+    }
+    if (reuse) reuse = isDrawableArraySorted(oldTiles, tileCount);
+    if (!reuse) {
+        arrsetlen(drawableTileRun, 0);
+        repeat(tileCount, i) {
+            Drawable d;
+            ZERO_STRUCT(d);
+            d.type = DRAWABLE_TILE;
+            d.depth = room->tiles[i].tileDepth;
+            d.tileIndex = (int32_t) i;
+            arrput(drawableTileRun, d);
+        }
+        oldTiles = drawableTileRun;
+        if (tileCount > 1) qsort(oldTiles, (size_t) tileCount, sizeof(Drawable), compareDrawables);
+    }
+
+    int32_t restCount = (int32_t) arrlen(runner->cachedDrawables);
+    arrsetlen(rest, 0);
+    if (restCount > 0) {
+        arrsetlen(rest, (size_t) restCount);
+        memcpy(rest, runner->cachedDrawables, (size_t) restCount * sizeof(Drawable));
+        if (restCount > 1) qsort(rest, (size_t) restCount, sizeof(Drawable), compareDrawables);
+    }
+
+    arrsetlen(runner->cachedDrawables, (size_t) (restCount + tileCount));
+    int32_t a = 0, b = 0, out = 0;
+    while (restCount > a || tileCount > b) {
+        bool takeTile = restCount <= a || (tileCount > b && compareDrawables(&oldTiles[b], &rest[a]) < 0);
+        runner->cachedDrawables[out++] = takeTile ? oldTiles[b++] : rest[a++];
+    }
+}
