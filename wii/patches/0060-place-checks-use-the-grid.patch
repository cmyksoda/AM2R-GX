     return RValue_makeBool(free);
 }
 
+// Whether an instance blocks the caller's box: active, not the caller, solid when only solids count, and overlapping.
+static bool placeBlockedBy(Runner* runner, Instance* caller, Instance* other, InstanceBBox callerBBox, bool solidOnly) {
+    if (!other->active || (solidOnly && !other->solid) || other == caller) return false;
+    InstanceBBox otherBBox = Collision_computeBBox(runner, other);
+    return otherBBox.valid && Collision_instancesOverlapPrecise(runner, caller, other, callerBBox, otherBBox);
+}
+
+// Whether anything blocks the caller's box, looked for in the grid cells under it when those and the grid's dirty list
+// hold fewer instances than the room: clean instances are in their cells and dirty ones are on the list; the grid is
+// not synced (that would reorder cells for later queries). The answer is "any hit", so the order cannot change it.
+// -1: walk the room instead.
+static int32_t placeBlockedInGrid(Runner* runner, Instance* caller, InstanceBBox callerBBox, bool solidOnly) {
+    SpatialGrid* grid = runner->spatialGrid;
+    GMLReal limit = 1000000.0;
+    if (!(limit > GMLReal_fabs(callerBBox.left) && limit > GMLReal_fabs(callerBBox.top) &&
+          limit > GMLReal_fabs(callerBBox.right) && limit > GMLReal_fabs(callerBBox.bottom))) return -1;
+
+    int32_t dirtyCount = (int32_t) arrlen(grid->dirtyInstances);
+    int32_t candidates = dirtyCount;
+    SpatialGridRange range = SpatialGrid_computeCellRange(grid, callerBBox.left, callerBBox.top, callerBBox.right, callerBBox.bottom);
+    for (int32_t gx = range.minGridX; range.maxGridX >= gx; gx++)
+        for (int32_t gy = range.minGridY; range.maxGridY >= gy; gy++)
+            candidates += (int32_t) arrlen(grid->grid[SpatialGrid_cellIndex(grid, gx, gy)]);
+    if (candidates >= (int32_t) arrlen(runner->instances)) return -1;
+
+    SpatialGridQuery query = SpatialGrid_prepareQuery(runner, callerBBox.left, callerBBox.top, callerBBox.right, callerBBox.bottom, INSTANCE_ALL);
+    for (int32_t gx = query.range.minGridX; query.range.maxGridX >= gx; gx++) {
+        for (int32_t gy = query.range.minGridY; query.range.maxGridY >= gy; gy++) {
+            Instance** cell = grid->grid[SpatialGrid_cellIndex(grid, gx, gy)];
+            int32_t cellLen = (int32_t) arrlen(cell);
+            repeat(cellLen, ci) {
+                Instance* other = cell[ci];
+                if (other->spatialGridDirty || other->lastCollisionQueryId == query.queryId) continue;
+                other->lastCollisionQueryId = query.queryId;
+                if (placeBlockedBy(runner, caller, other, callerBBox, solidOnly)) return 1;
+            }
+        }
+    }
+    repeat(dirtyCount, di) {
+        Instance* other = hmget(runner->instancesById, grid->dirtyInstances[di]);
+        if (other == nullptr || !other->spatialGridDirty || other->lastCollisionQueryId == query.queryId) continue;
+        other->lastCollisionQueryId = query.queryId;
+        if (placeBlockedBy(runner, caller, other, callerBBox, solidOnly)) return 1;
+    }
+    return 0;
+}
