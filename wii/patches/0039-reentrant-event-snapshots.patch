Reason: nested health/lives events must not overwrite the outer event snapshot.
Keep snapshots as stacked ranges and reload the shared allocation after callbacks.
Upstream: correctness fix, every platform. Retire this patch when merged.

--- a/src/runner.c
+++ b/src/runner.c
@@ -507,7 +507,7 @@
 
     // We always snapshot the iteration list before dispatching so instances spawned during this phase do NOT fire the current event.
     Instance** scratch = runner->eventDispatchInstances;
-    arrsetlen(scratch, 0);
+    size_t snapshotBase = arrlenu(scratch);
 
     if (eventUsesPerObjectDispatch(eventType)) {
         ResolvedEventTable* table = &runner->eventTable;
@@ -528,8 +528,8 @@
 
         int32_t snapshotCount = (int32_t) arrlen(scratch);
         {
-        repeat(snapshotCount, i) {
-            Instance* inst = scratch[i];
+        for (int32_t i = (int32_t) snapshotBase; snapshotCount > i; i++) {
+            Instance* inst = runner->eventDispatchInstances[i];
