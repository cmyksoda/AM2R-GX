Reason: collision query IDs must not collide with unvisited or stale instance marks after wrapping.
Clear the live registry and grid before restarting IDs at one, including Cleanup callbacks after ID removal.
Upstream: correctness fix, every platform. Retire this patch when merged.

--- a/src/spatial_grid.c
+++ b/src/spatial_grid.c
@@ -165,6 +165,19 @@
     bool filterByObject = target >= 0 && INSTANCE_ID_BASE > target;
     bool filterByInstanceId = target >= INSTANCE_ID_BASE;
     uint32_t queryId = ++runner->collisionQueryCounter;
+    if (queryId == 0) {
+        // Saved-room instances also retain marks, so clear the complete ID registry.
+        repeat(hmlen(runner->instancesById), i) {
+            runner->instancesById[i].value->lastCollisionQueryId = 0;
+        }
+        // Cleanup callbacks can query an instance already removed from the ID map.
+        SpatialGrid* grid = runner->spatialGrid;
+        repeat((int32_t) grid->gridWidth * grid->gridHeight, cellIndex) {
+            Instance** cell = grid->grid[cellIndex];
+            repeat(arrlen(cell), i) cell[i]->lastCollisionQueryId = 0;
+        }
+        queryId = ++runner->collisionQueryCounter;
+    }
     SpatialGridQuery ret = {0};
     ret.range = callerRange;
     ret.filterByObject = filterByObject;
