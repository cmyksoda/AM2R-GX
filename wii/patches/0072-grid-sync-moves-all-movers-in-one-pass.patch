+// One mover of a sync: its old cells as cell indices (the first few kept inline), and where its box lands.
+typedef struct {
+    Instance* inst;
+    int32_t oldCount;
+    int32_t oldCells[4];
+    InstanceBBox box;
+} SyncMover;
+
+static uint32_t hashMover(Instance* inst, uint32_t mask) {
+    return (uint32_t) (((uintptr_t) inst >> 4) * 2654435761u) & mask;
+}
+
+// Whether the mover in moverSlots owns an entry in cellIndex: true when the cell is one of its old cells, the cells
+// one-at-a-time removal would have looked in.
+static bool moverLeavesCell(SpatialGrid* grid, SyncMover* movers, int32_t* moverSlots, uint32_t mask, Instance* inst, int32_t cellIndex) {
+    for (uint32_t h = hashMover(inst, mask); moverSlots[h] >= 0; h = (h + 1) & mask) {
+        SyncMover* m = &movers[moverSlots[h]];
+        if (m->inst != inst) continue;
+        if (4 >= m->oldCount) {
+            repeat(m->oldCount, c) if (m->oldCells[c] == cellIndex) return true;
+            return false;
+        }
+        repeat(arrlen(inst->collisionCells), c) {
+            uint32_t g = inst->collisionCells[c];
+            if (SpatialGrid_cellIndex(grid, SpatialGrid_unpackGridX(g), SpatialGrid_unpackGridY(g)) == cellIndex) return true;
+        }
+        return false;
+    }
+    return false;
+}
