+// Queries test a target's dirty members directly, and a burst of them (crumbling sand asks about its 8 neighbors) scanned
+// the whole list each time: the list of them is kept per target while the dirty epochs of the objects whose instances
+// the list may hold (the target and every descendant) stay as they were.
+typedef struct {
+    uint64_t epoch, objectSum;
+    Instance** list;
+    int32_t count;
+    Instance** members;
+    int32_t* objects;
+    bool objectsKnown;
+} DirtyMembers;
+
+// The objects whose instances join the target's list: the target and every object with it in its parent chain.
+static void dirtyMembersFindObjects(Runner* runner, DirtyMembers* dm, int32_t targetObjIndex) {
+    DataWin* dataWin = runner->dataWin;
+    repeat(dataWin->objt.count, o) {
+        int32_t currentObj = (int32_t) o, depth = 0;
+        while (currentObj >= 0 && dataWin->objt.count > (uint32_t) currentObj && 32 > depth) {
+            if (currentObj == targetObjIndex) {
+                arrput(dm->objects, (int32_t) o);
+                break;
+            }
+            currentObj = dataWin->objt.objects[currentObj].parentId;
+            depth++;
+        }
+    }
+    dm->objectsKnown = true;
+}
+
+Instance** Runner_dirtyMembersOf(Runner* runner, int32_t targetObjIndex, int32_t* count) {
+    static DirtyMembers* cache = nullptr;
+    static uint32_t cacheCount = 0;
+    if (cacheCount < runner->dataWin->objt.count) {
+        cache = (DirtyMembers*) safeRealloc(cache, (size_t) runner->dataWin->objt.count * sizeof(DirtyMembers));
+        memset(&cache[cacheCount], 0, (size_t) (runner->dataWin->objt.count - cacheCount) * sizeof(DirtyMembers));
+        cacheCount = runner->dataWin->objt.count;
+    }
+    DirtyMembers* dm = &cache[targetObjIndex];
+    if (!dm->objectsKnown) dirtyMembersFindObjects(runner, dm, targetObjIndex);
+    Instance** list = runner->instancesByObject[targetObjIndex];
+    int32_t listCount = (int32_t) arrlen(list);
+    uint64_t objectSum = 0;
+    repeat(arrlen(dm->objects), k) {
+        int32_t o = dm->objects[k];
+        if (SpatialGrid_objectDirtyEpochCount > o) objectSum += SpatialGrid_objectDirtyEpochs[o];
+    }
+    if (dm->epoch != SpatialGrid_dirtyEpoch || dm->objectSum != objectSum || dm->list != list || dm->count != listCount) {
+        arrsetlen(dm->members, 0);
+        repeat(listCount, i) {
+            if (list[i]->spatialGridDirty) arrput(dm->members, list[i]);
+        }
+        dm->epoch = SpatialGrid_dirtyEpoch;
+        dm->objectSum = objectSum;
+        dm->list = list;
+        dm->count = listCount;
+    }
+    *count = (int32_t) arrlen(dm->members);
+    return dm->members;
+}
