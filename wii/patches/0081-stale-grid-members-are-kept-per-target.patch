+void SpatialGrid_touchObject(int32_t objectIndex) {
+    if (0 > objectIndex) return;
+    if (objectIndex >= SpatialGrid_objectDirtyEpochCount) {
+        int32_t n = objectIndex + 64;
+        SpatialGrid_objectDirtyEpochs = (uint64_t*) safeRealloc(SpatialGrid_objectDirtyEpochs, (size_t) n * sizeof(uint64_t));
+        memset(&SpatialGrid_objectDirtyEpochs[SpatialGrid_objectDirtyEpochCount], 0,
+               (size_t) (n - SpatialGrid_objectDirtyEpochCount) * sizeof(uint64_t));
+        SpatialGrid_objectDirtyEpochCount = n;
+    }
+    SpatialGrid_objectDirtyEpochs[objectIndex]++;
+}
 
