+// One side of a pixel scan. A sample can only hit where it lands inside the sprite and, for a precise one, on a set
+// pixel of its mask: corner samples go through pointInInstanceTurned's arithmetic, and rotation and scale keep every
+// sample between them, so a block whose corners can't reach such pixels holds no hit.
+typedef struct {
+    Sprite* spr;
+    Instance* inst;
+    const CollisionTurn* turn;
+    double minScale;
+    int32_t box[4];
+    const uint8_t* cells;
+    int32_t cellsX;
+    bool usable, empty, blocks;
+} CollisionScanSide;
+
+static inline CollisionScanSide Collision_scanSide(Sprite* spr, Instance* inst, const CollisionTurn* turn) {
+    CollisionScanSide side;
+    memset(&side, 0, sizeof side);
+    side.spr = spr;
+    side.inst = inst;
+    side.turn = turn;
+    side.minScale = fmin(fabs((double) inst->imageXscale), fabs((double) inst->imageYscale));
+    // Under this scale the float slack below would not cover rounding; such sides are always scanned.
+    side.usable = side.minScale >= 0.01;
+    if (!side.usable) return side;
+    if (Collision_hasFrameMasks(spr)) {
+        uint32_t frameIdx = ((uint32_t) inst->imageIndex) % spr->maskCount;
+        side.empty = !DataWin_spriteMaskBox(spr, frameIdx, side.box);
+        side.cells = DataWin_spriteMaskCells(spr, frameIdx);
+        side.cellsX = (int32_t) ((spr->width + DATAWIN_MASK_CELL - 1) / DATAWIN_MASK_CELL);
+    } else {
+        side.box[2] = (int32_t) spr->width - 1;
+        side.box[3] = (int32_t) spr->height - 1;
+        side.empty = 0 > side.box[2] || 0 > side.box[3];
+    }
+    return side;
+}
+
+// Whether any sample of columns x0..x1 and rows y0..y1 may land on a pixel this side can be hit at; *inside when every
+// one lands inside its box.
+static inline bool Collision_scanSideMayHit(const CollisionScanSide* side, int32_t x0, int32_t x1, int32_t y0, int32_t y1, GMLReal sampleOffset, bool useCells, bool* inside) {
+    if (inside != nullptr) *inside = false;
+    if (!side->usable) return true;
+    if (side->empty) return false;
+    Instance* inst = side->inst;
+    double lowX = 0, highX = 0, lowY = 0, highY = 0;
+    repeat(4, corner) {
+        GMLReal dx = (GMLReal) ((corner & 1) ? x1 : x0) + sampleOffset - inst->x;
+        GMLReal dy = (GMLReal) ((corner & 2) ? y1 : y0) + sampleOffset - inst->y;
+        double slack = 0.5 + 1e-4 * ((fabs((double) dx) + fabs((double) dy)) / side->minScale + fabs((double) side->spr->originX) + fabs((double) side->spr->originY));
+        if (side->turn->on) {
+            GMLReal rx = side->turn->cs * dx - side->turn->sn * dy;
+            GMLReal ry = side->turn->sn * dx + side->turn->cs * dy;
+            dx = rx;
+            dy = ry;
+        }
+        if (inst->imageXscale != 1.0f)
+            dx = inst->imageXscale == -1.0f ? -dx : dx / inst->imageXscale;
+        if (inst->imageYscale != 1.0f)
+            dy = inst->imageYscale == -1.0f ? -dy : dy / inst->imageYscale;
+        double localX = (double) (dx + (GMLReal) side->spr->originX), localY = (double) (dy + (GMLReal) side->spr->originY);
+        if (!(fabs(localX) < 1e9 && fabs(localY) < 1e9)) return true;
+        if (corner == 0 || localX - slack < lowX) lowX = localX - slack;
+        if (corner == 0 || localX + slack > highX) highX = localX + slack;
+        if (corner == 0 || localY - slack < lowY) lowY = localY - slack;
+        if (corner == 0 || localY + slack > highY) highY = localY + slack;
+    }
+    if (!(lowX > -2e9 && highX < 2e9 && lowY > -2e9 && highY < 2e9)) return true;
+    // Truncation is monotonic, so these are the only pixels the samples can land on.
+    int32_t px0 = (int32_t) lowX, px1 = (int32_t) highX, py0 = (int32_t) lowY, py1 = (int32_t) highY;
+    if (inside != nullptr)
+        *inside = px0 >= side->box[0] && side->box[2] >= px1 && py0 >= side->box[1] && side->box[3] >= py1;
+    if (side->box[0] > px0) px0 = side->box[0];
+    if (px1 > side->box[2]) px1 = side->box[2];
+    if (side->box[1] > py0) py0 = side->box[1];
+    if (py1 > side->box[3]) py1 = side->box[3];
+    if (px0 > px1 || py0 > py1) return false;
+    if (!useCells || side->cells == nullptr) return true;
+    for (int32_t cy = py0 / DATAWIN_MASK_CELL; py1 / DATAWIN_MASK_CELL >= cy; cy++)
+        for (int32_t cx = px0 / DATAWIN_MASK_CELL; px1 / DATAWIN_MASK_CELL >= cx; cx++)
+            if (side->cells[cy * side->cellsX + cx]) return true;
+    return false;
+}
+
+#define COLLISION_SCAN_BLOCK 4
+// Overlaps with fewer samples past the first row are scanned row by row: the block tests cost more than they save.
+#define COLLISION_SCAN_BLOCKS_FROM 384
