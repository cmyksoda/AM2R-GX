+        for (int64_t bx = startX; lastX >= bx; bx += COLLISION_SCAN_BLOCK) {
+            int64_t bxEnd = bx + COLLISION_SCAN_BLOCK - 1 > lastX ? lastX : bx + COLLISION_SCAN_BLOCK - 1;
+            if ((sideA.blocks && !Collision_scanSideMayHit(&sideA, (int32_t) bx, (int32_t) bxEnd, (int32_t) by, (int32_t) byEnd, sampleOffset, true, nullptr)) ||
+                (sideB.blocks && !Collision_scanSideMayHit(&sideB, (int32_t) bx, (int32_t) bxEnd, (int32_t) by, (int32_t) byEnd, sampleOffset, true, nullptr)))
