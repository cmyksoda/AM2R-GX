+bool DataWin_spriteMaskBox(Sprite* spr, uint32_t frameIdx, int32_t box[4]) {
+    if (spr->maskBox == nullptr) {
+        spr->maskBox = (int32_t*) safeMalloc(spr->maskCount * 4 * sizeof(int32_t));
+        repeat(spr->maskCount, i) spr->maskBox[i * 4] = -2;
+    }
+    int32_t* known = &spr->maskBox[frameIdx * 4];
+    if (known[0] == -2) {
+        uint8_t* mask = spr->masks[frameIdx];
+        uint32_t bytesPerRow = (spr->maskWidth + 7) / 8;
+        int32_t x0 = INT32_MAX, x1 = INT32_MIN, y0 = INT32_MAX, y1 = INT32_MIN;
+        repeat(spr->maskHeight, my) {
+            repeat(spr->maskWidth, mx) {
+                if (!(mask[my * bytesPerRow + (mx >> 3)] & (1 << (7 - (mx & 7))))) continue;
+                int32_t x = (int32_t) mx + spr->maskOffsetX, y = (int32_t) my + spr->maskOffsetY;
+                if (0 > x || 0 > y || x >= (int32_t) spr->width || y >= (int32_t) spr->height) continue;
+                if (x0 > x) x0 = x;
+                if (x > x1) x1 = x;
+                if (y0 > y) y0 = y;
+                if (y > y1) y1 = y;
+            }
+        }
+        known[0] = x1 >= x0 ? x0 : -1;
+        known[1] = y0;
+        known[2] = x1;
+        known[3] = y1;
+    }
+    if (0 > known[0]) return false;
+    memcpy(box, known, 4 * sizeof(int32_t));
+    return true;
+}
+
+const uint8_t* DataWin_spriteMaskCells(Sprite* spr, uint32_t frameIdx) {
+    if (spr->maskCells == nullptr) spr->maskCells = (uint8_t**) safeCalloc(spr->maskCount, sizeof(uint8_t*));
+    if (spr->maskCells[frameIdx] != nullptr) return spr->maskCells[frameIdx];
+    uint32_t cellsX = (spr->width + DATAWIN_MASK_CELL - 1) / DATAWIN_MASK_CELL;
+    uint32_t cellsY = (spr->height + DATAWIN_MASK_CELL - 1) / DATAWIN_MASK_CELL;
+    uint8_t* cells = (uint8_t*) safeCalloc((size_t) cellsX * cellsY + 1, 1);
+    uint8_t* mask = spr->masks[frameIdx];
+    uint32_t bytesPerRow = (spr->maskWidth + 7) / 8;
+    repeat(spr->maskHeight, my) {
+        repeat(spr->maskWidth, mx) {
+            if (!(mask[my * bytesPerRow + (mx >> 3)] & (1 << (7 - (mx & 7))))) continue;
+            int32_t x = (int32_t) mx + spr->maskOffsetX, y = (int32_t) my + spr->maskOffsetY;
+            if (0 > x || 0 > y || x >= (int32_t) spr->width || y >= (int32_t) spr->height) continue;
+            cells[(uint32_t) y / DATAWIN_MASK_CELL * cellsX + (uint32_t) x / DATAWIN_MASK_CELL] = 1;
+        }
+    }
+    spr->maskCells[frameIdx] = cells;
+    return cells;
+}
