@@ -462,6 +462,47 @@
 //
 // BC13/BC14, BC17+: a single GML local can surface as several VARI chunk entries that share a varID (BC17+) or has no pre-assigned slot at all (BC13/BC14).
 // We key by varID/varIdx via the per-code currentCodeLocalsSlotMap so reads/writes via any reference agree on the same localVars slot.
+// Every event and script call allocates its locals (and a script call its arguments), thousands of times a frame. Small
+// blocks are recycled through per-size free lists instead of malloc/free; a reused block is cleared, as calloc's is.
+#define FRAME_BLOCK_MAX 32
+#define FRAME_BLOCK_KEEP 16
+
+typedef struct FrameBlock {
+    struct FrameBlock* next;
+    uint32_t count;
+} FrameBlock;
+
+static FrameBlock* frameBlockLists[FRAME_BLOCK_MAX + 1];
+static uint32_t frameBlockKept[FRAME_BLOCK_MAX + 1];
+
+static RValue* frameAlloc(uint32_t count) {
+    RValue* block;
+    if (FRAME_BLOCK_MAX >= count && frameBlockLists[count] != nullptr) {
+        FrameBlock* reused = frameBlockLists[count];
+        frameBlockLists[count] = reused->next;
+        frameBlockKept[count]--;
+        block = (RValue*) reused;
+    } else {
+        block = (RValue*) safeMalloc((count + 1) * sizeof(RValue));
+    }
+    ((FrameBlock*) block)->count = count;
+    memset(block + 1, 0, count * sizeof(RValue));
+    return block + 1;
+}
+
+static void frameFree(RValue* values) {
+    if (values == nullptr) return;
+    FrameBlock* block = (FrameBlock*) (values - 1);
+    uint32_t count = block->count;
+    if (FRAME_BLOCK_MAX >= count && FRAME_BLOCK_KEEP > frameBlockKept[count]) {
+        block->next = frameBlockLists[count];
+        frameBlockLists[count] = block;
+        frameBlockKept[count]++;
+    } else {
+        free(block);
+    }
+}
