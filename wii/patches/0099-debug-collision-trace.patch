 // ===[ REGISTRATION ]===
 
+
+#ifdef PLATFORM_WII
+/* Dolphin-only collision-query trace: what the traced instance asked and what it got (wii/src/menu.c drives it). */
+extern bool Wii_coltrace;
+extern int32_t Wii_coltraceObj;
+static void coltrace(VMContext* ctx, const char* name, RValue* args, int32_t argCount, RValue result) {
+    Instance* self = ctx->currentInstance;
+    char buf[200];
+    int n = 0, i;
+    if (!Wii_coltrace || self == nullptr || self->objectIndex != Wii_coltraceObj) return;
+    for (i = 0; i < argCount && i < 8 && n < (int) sizeof buf - 24; i++) n += snprintf(buf + n, sizeof buf - n, " %g", (double) RValue_toReal(args[i]));
+    logInfo("COL %s at %g,%g:%s -> %g\n", name, (double) self->x, (double) self->y, buf, (double) RValue_toReal(result));
+}
+#define COLTRACE_WRAP(name) \
+    static RValue builtin_##name(VMContext* ctx, RValue* args, int32_t argCount) { \
+        RValue r = builtin_##name##_impl(ctx, args, argCount); \
+        coltrace(ctx, #name, args, argCount, r); \
+        return r; \
+    }
+#else
+#define COLTRACE_WRAP(name) \
+    static RValue builtin_##name(VMContext* ctx, RValue* args, int32_t argCount) { return builtin_##name##_impl(ctx, args, argCount); }
+#endif
+COLTRACE_WRAP(place_meeting)
+COLTRACE_WRAP(place_free)
+COLTRACE_WRAP(instance_place)
+COLTRACE_WRAP(instance_position)
+COLTRACE_WRAP(collision_rectangle)
+COLTRACE_WRAP(collision_line)
+COLTRACE_WRAP(collision_point)
+
+
