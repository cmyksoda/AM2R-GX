+static bool activationIndexCurrent(Runner* runner) {
+    ActivationIndex* ix = &activationIndex;
+    SpatialGrid* grid = runner->spatialGrid;
+    return ix->built && grid != nullptr && ix->grid == grid && ix->version == runner->activationVersion &&
+           ix->gridEdits == grid->inactiveEdits;
+}
+
+// The instance's live entry, or -1.
+static int32_t activationIndexEntryOf(Runner* runner, Instance* inst) {
+    ActivationIndex* ix = &activationIndex;
+    int32_t e = inst->activationIndexEntry;
+    if (inst->activationIndexBuild != runner->activationIndexBuild || 0 > e || e >= (int32_t) arrlen(ix->entries) ||
+        ix->entries[e] != inst)
+        return -1;
+    return e;
+}
+
+void ActivationIndex_noteSleep(Runner* runner, Instance* instance) {
+    ActivationIndex* ix = &activationIndex;
+    if (instance->destroyed || !activationIndexCurrent(runner)) return;
+    GMLReal box[4];
+    activationBox(runner, instance, box);
+    int32_t e = activationIndexEntryOf(runner, instance);
+    if (e >= 0) {
+        GMLReal* old = &ix->boxes[4 * e];
+        if (old[0] == box[0] && old[1] == box[1] && old[2] == box[2] && old[3] == box[3]) return;
+        ix->entries[e] = nullptr;
+        ix->cleared++;
+    }
+    activationIndexAdd(runner, instance, box);
+    if (ix->cleared > 4096 && ix->cleared > (uint32_t) arrlen(ix->entries) / 2) ix->built = false;
+}
+
+void ActivationIndex_forget(Runner* runner, Instance* instance) {
+    ActivationIndex* ix = &activationIndex;
+    int32_t e = activationIndexEntryOf(runner, instance);
+    if (e < 0) return;
+    ix->entries[e] = nullptr;
+    ix->cleared++;
+}
