-    inst->hspeed = (float) (inst->speed * clampFloat(GMLReal_cos(inst->direction * (M_PI / 180.0))));
-    inst->vspeed = (float) (-inst->speed * clampFloat(GMLReal_sin(inst->direction * (M_PI / 180.0))));
+#ifndef USE_FLOAT_REALS
+    GMLReal cs = 0.0, sn = 0.0;
+    bool cardinal = isfinite(inst->speed);
+    if (inst->direction == 0.0f) {
+        cs = 1.0;
+    } else if (inst->direction == 90.0f) {
+        sn = 1.0;
+    } else if (inst->direction == 180.0f) {
+        cs = -1.0;
+    } else if (inst->direction == 270.0f) {
+        sn = -1.0;
+    } else {
+        cardinal = false;
+    }
+    if (cardinal) {
+        inst->hspeed = (float) (inst->speed * cs);
+        inst->vspeed = (float) (-inst->speed * sn);
+    } else
+#endif
+    {
+        inst->hspeed = (float) (inst->speed * clampFloat(GMLReal_cos(inst->direction * (M_PI / 180.0))));
+        inst->vspeed = (float) (-inst->speed * clampFloat(GMLReal_sin(inst->direction * (M_PI / 180.0))));
+    }
 
     // Round if very close to integer
