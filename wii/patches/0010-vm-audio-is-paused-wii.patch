Reason: audio_is_paused was !isPlaying, which can never be true for a paused sound under GM semantics; AM2R's area music never resumed after an item jingle. Asks the Wii backend instead.
Upstream: Engine bug on every platform; proper fix is an isPaused slot in the AudioSystem vtable - offered upstream from the session 8 fork branch. Retires this patch when merged.

--- a/src/vm_builtins.c
+++ b/src/vm_builtins.c
@@ -7134,8 +7134,14 @@
     AudioSystem* audio = ctx->runner->audioSystem;
     if (audio == nullptr) return RValue_makeBool(false);
     int32_t soundOrInstance = RValue_toInt32(args[0]);
+#ifdef PLATFORM_WII
+    // GM reports a paused sound as still playing, so "!isPlaying" can never see one. Ask the backend.
+    extern bool WiiAudio_isPaused(AudioSystem* audio, int32_t soundOrInstance);
+    return RValue_makeBool(WiiAudio_isPaused(audio, soundOrInstance));
+#else
     bool playing = audio->vtable->isPlaying(audio, soundOrInstance);
     return RValue_makeBool(!playing);
+#endif
 }
 
 
