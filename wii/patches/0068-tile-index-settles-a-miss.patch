         if (k >= 0 && (uint32_t) tileIndexById[k].value < room->tileCount &&
             room->tiles[tileIndexById[k].value].instanceID == id) return tileIndexById[k].value;
+        // tile_add and tile_delete keep the index current, so an id it lacks isn't in the room: crumbling sand asks
+        // after tiles it has just deleted, and each such miss walked all ~4,800 of rm_a3h04's tiles.
+        if (k < 0) return -1;
     }
