Reason: a direction already in the canonical range is unchanged by modulo.
Preserve fmod for negative, out-of-range and non-finite directions.
Upstream: speed only, every platform. Retire this patch when merged.

--- a/src/instance.c
+++ b/src/instance.c
@@ -182,7 +182,9 @@
     if (GMLReal_fabs(inst->direction - GMLReal_round(inst->direction)) < 0.0001) {
         inst->direction = (float) GMLReal_round(inst->direction);
     }
-    inst->direction = (float) GMLReal_fmod((GMLReal) inst->direction, 360.0);
+    if (!(inst->direction >= 0.0f && inst->direction < 360.0f)) {
+        inst->direction = (float) GMLReal_fmod((GMLReal) inst->direction, 360.0);
+    }
 
     // Speed
     inst->speed = (float) GMLReal_sqrt(inst->hspeed * inst->hspeed + inst->vspeed * inst->vspeed);
