+// Writes run entries [from, to) to out: live tiles only, with array indices, and each pseudo index's rank among the live
+// tiles into tileRunRankOf (-1 for dead ones). Pseudo indices rise within a depth, so the gone pointer restarts at each.
+typedef struct {
+    int32_t rank, goneAt, depth;
+    bool started;
+} TileRunEmit;
+
+static int32_t tileRunEmit(Drawable* out, int32_t from, int32_t to, TileRunEmit* state) {
+    int32_t written = 0, gone = (int32_t) arrlen(tileRunGone);
+    for (int32_t k = from; to > k; k++) {
+        Drawable* d = &drawableTileRun[k];
+        int32_t pseudo = d->tileIndex;
+        if (!state->started || d->depth != state->depth) {
+            state->started = true;
+            state->depth = d->depth;
+            state->goneAt = 0;
+        }
+        if (tileRunDead[k]) {
+            tileRunRankOf[pseudo] = -1;
+            continue;
+        }
+        while (gone > state->goneAt && pseudo > tileRunGone[state->goneAt]) state->goneAt++;
+        out[written] = *d;
+        out[written].tileIndex = pseudo - state->goneAt;
+        written++;
+        tileRunRankOf[pseudo] = state->rank++;
+    }
+    return written;
+}
