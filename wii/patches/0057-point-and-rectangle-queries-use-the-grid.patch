+// collision_point's test of one instance (box = the point twice); prec also asks for the mask.
+static bool collisionPointHitsInstance(VMContext* ctx, Instance* inst, const GMLReal* box, int32_t prec) {
+    if (!Collision_pointInsideInstanceBox(ctx->runner, inst, box[0], box[1])) return false;
+    if (prec != 0) {
+        Sprite* spr = Collision_getSprite(ctx->dataWin, inst);
+        if (Collision_hasFrameMasks(spr) && !Collision_pointInInstance(spr, inst, box[0], box[1])) return false;
+    }
+    return true;
+}
